name: lab-computer-network-012

topology:
  nodes:
    pc1:
      kind: linux
      image: ghcr.io/nicolaka/netshoot:v0.16
      labels:
        flow_icon: pc
      exec:
        - /bin/sh -c "adduser -D -s /bin/sh admin 2>/dev/null || true"
        - /bin/sh -c "echo admin:admin | chpasswd"
        - ssh-keygen -A
        - mkdir -p /run/sshd
        - /bin/sh -c "echo PasswordAuthentication=yes >> /etc/ssh/sshd_config"
        - /usr/sbin/sshd
    dns1:
      kind: linux
      image: internetsystemsconsortium/bind9:9.20
      labels:
        flow_icon: server
      binds:
        - configs/dns1/named.conf:/etc/bind/named.conf
        - configs/dns1/db.lab.example:/var/lib/bind/db.lab.example
      exec:
        - ip link set eth1 up
        - ip addr replace 10.12.0.53/24 dev eth1
  links:
    - endpoints: ["pc1:eth1", "dns1:eth1"]
